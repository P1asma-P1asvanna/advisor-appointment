# Production only. Leave empty in development (Vite proxies /api to the backend).
# Example: https://api.example.edu  (the backend's CORS_ORIGINS must include this site's origin)
VITE_API_URL=
# Show the "demo accounts" buttons on the login page in a production build (they always show with npm run dev). Keep false once real users sign in.
VITE_SHOW_DEMO=false
