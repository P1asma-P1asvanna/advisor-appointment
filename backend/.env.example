# Copy to .env and export it (or pass the variables to your process manager).
APP_ENV=dev                      # "dev" allows the built-in JWT secret. Leave unset/prod in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/advisor
JWT_SECRET=                      # required unless APP_ENV=dev: a random string of 32+ characters
JWT_TTL_MINUTES=480
DB_TIMEZONE=Asia/Bangkok
CORS_ORIGINS=http://localhost:5173   # comma separated, the origins of your web front end

# --- sign-in protection ---
LOGIN_MAX_FAILURES=5          # wrong passwords allowed per email ...
LOGIN_WINDOW_MINUTES=15       # ... inside this many minutes before the email is locked for the rest of the window

# --- first admin (only used while the database has no admin; remove the password afterwards) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=ผู้ดูแลระบบ
